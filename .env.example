# Copy this file to .env and fill in the value. .env is ignored by git.
# Optional: enables Narration voice generation (OpenAI text-to-speech).
OPENAI_API_KEY=

# Exact HTTPS editor origins allowed to use this PC's processing service.
# ALLOWED_EDITOR_ORIGINS=https://your-editor.vercel.app

# Vercel frontend build setting. Leave unset for the local Vite editor.
# VITE_API_BASE_URL=http://127.0.0.1:3001
